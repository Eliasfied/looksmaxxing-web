{
  "name": "saas-template",
  "private": true,
  "scripts": {
    "test:funnel": "node --test tests/*.test.cjs tests/*.test.mjs",
    "content:preview": "node scripts/generate-content.mjs --dry-run",
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "type-check": "turbo type-check",
    "format": "prettier --write \"**/*.{ts,tsx,astro,md}\"",
    "indexnow": "node scripts/indexnow.mjs",
    "db:types": "supabase gen types typescript --local > packages/shared/src/types/database.ts"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@fal-ai/client": "^1.5.0",
    "prettier": "^3",
    "sharp": "^0.34.5",
    "turbo": "latest",
    "typescript": "^5"
  },
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20.0.0"
  }
}
