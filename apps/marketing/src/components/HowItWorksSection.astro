---
---

<section class="bg-[#080808] border-y border-white/5 py-20">
  <div class="max-w-5xl mx-auto px-4">
    <h2 class="text-3xl md:text-5xl font-black text-white text-center mb-14 leading-tight">
      Upload your Images and create<br class="hidden md:block" /> stunning AI Photos now
    </h2>

    <div class="flex flex-col md:flex-row items-center gap-6 md:gap-8">

      <!-- Left: 2x2 input photos -->
      <div class="grid grid-cols-2 gap-3 flex-shrink-0">
        <div class="w-36 md:w-44 aspect-[3/4] rounded-2xl overflow-hidden"><img src="/how-it-works/input-1.webp" alt="Input photo" class="w-full h-full object-cover" loading="lazy" /></div>
        <div class="w-36 md:w-44 aspect-[3/4] rounded-2xl overflow-hidden"><img src="/how-it-works/input-2.webp" alt="Input photo" class="w-full h-full object-cover" loading="lazy" /></div>
        <div class="w-36 md:w-44 aspect-[3/4] rounded-2xl overflow-hidden"><img src="/how-it-works/input-3.webp" alt="Input photo" class="w-full h-full object-cover" loading="lazy" /></div>
        <div class="w-36 md:w-44 aspect-[3/4] rounded-2xl overflow-hidden"><img src="/how-it-works/input-4.webp" alt="Input photo" class="w-full h-full object-cover" loading="lazy" /></div>
      </div>

      <!-- Arrow -->
      <div class="flex items-center justify-center flex-shrink-0 rotate-90 md:rotate-0">
        <svg width="80" height="60" viewBox="0 0 80 60" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M4 30 C 20 10, 45 10, 60 28" stroke="white" stroke-width="3" fill="none" stroke-linecap="round"/>
          <path d="M55 20 L 65 30 L 52 34" stroke="white" stroke-width="3" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </div>

      <!-- Right: AI output photo -->
      <div class="flex-1 max-w-sm md:max-w-none">
        <div class="rounded-2xl overflow-hidden aspect-[3/4]">
          <img src="/how-it-works/output.webp" alt="AI generated photo" class="w-full h-full object-cover" loading="lazy" />
        </div>
      </div>

    </div>
  </div>
</section>
