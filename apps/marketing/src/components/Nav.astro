---
import exploreData from '../data/explore-packs.json';
import toolsData from '../data/tools.json';

const BRAND_NAME = import.meta.env.PUBLIC_BRAND_NAME ?? '{{BRAND_NAME}}';
const APP_URL = import.meta.env.PUBLIC_APP_URL;

// Build category -> packs map, preserving insertion order
const grouped = (exploreData as any[]).reduce((acc: Record<string, any[]>, pack: any) => {
  if (!acc[pack.category]) acc[pack.category] = [];
  acc[pack.category].push(pack);
  return acc;
}, {} as Record<string, any[]>);

const categories = Object.keys(grouped);
---

<nav class="sticky top-0 z-50 bg-black border-b border-white/[0.06]">
  <div class="max-w-6xl mx-auto px-6 h-20 flex items-center justify-between">

    <!-- Logo -->
    <a href="/" class="flex items-center gap-2.5 text-lg font-bold text-white">
      <img src="/logo.png" alt={BRAND_NAME} width="30" height="30" class="rounded-lg" />
      {BRAND_NAME}
    </a>

    <!-- Mobile hamburger -->
    <button id="mobile-menu-btn" class="md:hidden flex flex-col gap-1.5 p-2" aria-label="Open menu">
      <span class="block w-6 h-0.5 bg-white transition-all duration-200" id="ham-1"></span>
      <span class="block w-6 h-0.5 bg-white transition-all duration-200" id="ham-2"></span>
      <span class="block w-6 h-0.5 bg-white transition-all duration-200" id="ham-3"></span>
    </button>

    <!-- Nav Links + CTA -->
    <div class="hidden md:flex items-center gap-8">

      {categories.length > 0 && (
        <!-- Explore mega-menu -->
        <div class="relative" id="explore-nav">
          <button
            id="explore-btn"
            class="flex items-center gap-1 text-[#888888] hover:text-white transition-colors text-base"
            aria-expanded="false"
          >
            Explore
            <svg class="w-3.5 h-3.5 mt-0.5 transition-transform duration-200" id="explore-chevron" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
            </svg>
          </button>

          <!-- Mega-menu dropdown -->
          <div
            id="explore-menu"
            class="hidden absolute top-full left-0 mt-3 bg-[#0a0a0a] border border-white/[0.08] rounded-2xl shadow-2xl overflow-hidden"
          >
            <div class="flex">
              <!-- Left: categories only -->
              <div class="w-52 py-3 flex-shrink-0">
                {categories.map((cat) => (
                  <button
                    class="explore-cat-btn w-full text-left px-4 py-2.5 text-sm font-medium text-[#888] transition-colors hover:text-white hover:bg-white/5 rounded-lg flex items-center justify-between gap-2"
                    data-cat={cat}
                  >
                    <span>{cat}</span>
                    <svg class="w-3 h-3 opacity-0 transition-opacity explore-cat-arrow" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                    </svg>
                  </button>
                ))}
              </div>

              <!-- Right: packs panel (hidden until category hovered) -->
              <div id="explore-packs-panel" class="hidden border-l border-white/[0.06] py-4 px-4 w-[420px]">
                {categories.map((cat) => (
                  <div class="explore-cat-panel hidden" data-panel={cat}>
                    <p class="text-xs font-bold uppercase tracking-widest text-[#444] mb-3 px-1">{cat}</p>
                    <div class="grid grid-cols-2 gap-0.5">
                      {grouped[cat].map((pack: any) => (
                        <a
                          href={`/explore/${pack.slug}`}
                          class="flex items-center gap-2.5 px-3 py-2.5 rounded-xl hover:bg-white/5 transition-colors group"
                        >
                          <span class="text-base flex-shrink-0">{pack.emoji}</span>
                          <span class="text-white text-sm font-medium leading-snug group-hover:text-white/80 transition-colors">
                            {pack.h1}
                          </span>
                        </a>
                      ))}
                    </div>
                  </div>
                ))}
              </div>
            </div>
          </div>
        </div>
      )}

      <!-- Tools dropdown -->
      {(toolsData as any[]).length > 0 && (
        <div class="relative" id="tools-nav">
          <button
            id="tools-btn"
            class="flex items-center gap-1 text-[#888888] hover:text-white transition-colors text-base"
            aria-expanded="false"
          >
            Tools
            <svg class="w-3.5 h-3.5 mt-0.5 transition-transform duration-200" id="tools-chevron" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
            </svg>
          </button>

          <div
            id="tools-menu"
            class="hidden absolute top-full left-0 mt-3 bg-[#0a0a0a] border border-white/[0.08] rounded-2xl shadow-2xl overflow-hidden min-w-[260px]"
          >
            <div class="py-2 px-2">
              <p class="text-xs font-bold uppercase tracking-widest text-[#444] mb-1 px-3 pt-2 pb-1">Free Tools</p>
              {(toolsData as any[]).map((tool: any) => (
                <a
                  href={`/tools/${tool.slug}`}
                  class="flex items-center gap-2.5 px-3 py-2.5 rounded-xl hover:bg-white/5 transition-colors group"
                >
                  <span class="text-base flex-shrink-0">{tool.emoji}</span>
                  <span class="text-white text-sm font-medium group-hover:text-white/80 transition-colors">{tool.title}</span>
                </a>
              ))}
              <div class="border-t border-white/[0.06] mt-2 pt-2 px-1">
                <a href="/tools" class="flex items-center justify-between px-3 py-2 rounded-xl hover:bg-white/5 transition-colors group">
                  <span class="text-[#666] text-xs font-semibold group-hover:text-white transition-colors">All tools</span>
                  <svg class="w-3 h-3 text-[#444] group-hover:text-white transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                  </svg>
                </a>
              </div>
            </div>
          </div>
        </div>
      )}

      <a href="/pricing" class="text-[#888888] hover:text-white transition-colors text-base">Pricing</a>
      <a href="/faq" class="text-[#888888] hover:text-white transition-colors text-base">FAQ</a>
      <a href="/about" class="text-[#888888] hover:text-white transition-colors text-base">About</a>
      <a href={`${APP_URL}/login`} class="text-[#888888] hover:text-white transition-colors text-base">Login</a>

      <a
        href={`${APP_URL}/register`}
        class="btn-gradient text-white font-semibold px-5 py-2 rounded-full text-sm hover:opacity-90 transition-opacity"
      >
        Start Creating →
      </a>
    </div>

  </div>
</nav>

<!-- Mobile menu drawer -->
<div id="mobile-menu" class="hidden md:hidden fixed inset-0 z-40 bg-black/95 backdrop-blur-sm overflow-y-auto">
  <div class="max-w-6xl mx-auto px-6 py-6 flex flex-col gap-6">

    <!-- Close row -->
    <div class="flex items-center justify-between">
      <a href="/" class="flex items-center gap-2.5 text-lg font-bold text-white">
        <img src="/logo.png" alt={BRAND_NAME} width="30" height="30" class="rounded-lg" />
        {BRAND_NAME}
      </a>
      <button id="mobile-menu-close" aria-label="Close menu" class="p-2 text-white">
        <svg width="24" height="24" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <!-- Main links -->
    <div class="flex flex-col gap-1">
      <a href="/pricing" class="text-white text-lg font-semibold py-3 border-b border-white/10">Pricing</a>
      <a href="/faq" class="text-white text-lg font-semibold py-3 border-b border-white/10">FAQ</a>
      <a href="/about" class="text-white text-lg font-semibold py-3 border-b border-white/10">About</a>
    </div>

    <!-- Explore -->
    {(exploreData as any[]).length > 0 && (
      <div>
        <p class="text-xs font-bold uppercase tracking-widest text-[#444] mb-3">Explore</p>
        <div class="flex flex-col gap-1">
          {(exploreData as any[]).map((pack: any) => (
            <a href={`/explore/${pack.slug}`} class="flex items-center gap-3 py-2.5 text-[#aaa] hover:text-white transition-colors">
              <span>{pack.emoji}</span>
              <span class="text-sm font-medium">{pack.h1}</span>
            </a>
          ))}
        </div>
      </div>
    )}

    <!-- Tools -->
    {(toolsData as any[]).length > 0 && (
      <div>
        <p class="text-xs font-bold uppercase tracking-widest text-[#444] mb-3">Tools</p>
        <div class="flex flex-col gap-1">
          {(toolsData as any[]).map((tool: any) => (
            <a href={`/tools/${tool.slug}`} class="flex items-center gap-3 py-2.5 text-[#aaa] hover:text-white transition-colors">
              <span>{tool.emoji}</span>
              <span class="text-sm font-medium">{tool.title}</span>
            </a>
          ))}
        </div>
      </div>
    )}

    <!-- CTA -->
    <div class="flex flex-col gap-3 pt-2">
      <a href={`${APP_URL}/register`} class="btn-gradient text-white font-bold px-6 py-4 rounded-full text-center text-base hover:opacity-90 transition-opacity">
        Start Creating →
      </a>
      <a href={`${APP_URL}/login`} class="text-center text-[#888] text-sm py-2 hover:text-white transition-colors">
        Already have an account? Login
      </a>
    </div>

  </div>
</div>

<script>
  const exploreBtn = document.getElementById('explore-btn');
  const exploreMenu = document.getElementById('explore-menu');
  const exploreChevron = document.getElementById('explore-chevron');
  const exploreNavItem = document.getElementById('explore-nav');
  const packsPanel = document.getElementById('explore-packs-panel');
  const catBtns = document.querySelectorAll<HTMLButtonElement>('.explore-cat-btn');
  const panels = document.querySelectorAll<HTMLElement>('.explore-cat-panel');

  if (exploreBtn && exploreMenu && exploreChevron && exploreNavItem) {
    function activateCategory(cat: string) {
      catBtns.forEach(b => {
        const active = b.dataset.cat === cat;
        b.classList.toggle('text-white', active);
        b.classList.toggle('bg-white/5', active);
        b.classList.toggle('text-[#888]', !active);
        const arrow = b.querySelector('.explore-cat-arrow') as HTMLElement;
        if (arrow) arrow.style.opacity = active ? '1' : '0';
      });
      panels.forEach(p => p.classList.toggle('hidden', p.dataset.panel !== cat));
      packsPanel?.classList.remove('hidden');
    }

    function deactivateCategory() {
      catBtns.forEach(b => {
        b.classList.remove('text-white', 'bg-white/5');
        b.classList.add('text-[#888]');
        const arrow = b.querySelector('.explore-cat-arrow') as HTMLElement;
        if (arrow) arrow.style.opacity = '0';
      });
      panels.forEach(p => p.classList.add('hidden'));
      packsPanel?.classList.add('hidden');
    }

    catBtns.forEach(b => {
      b.addEventListener('mouseenter', () => activateCategory(b.dataset.cat!));
    });

    function openExploreMenu() {
      exploreMenu.classList.remove('hidden');
      exploreChevron.style.transform = 'rotate(180deg)';
      exploreBtn.setAttribute('aria-expanded', 'true');
      deactivateCategory();
    }
    function closeExploreMenu() {
      exploreMenu.classList.add('hidden');
      exploreChevron.style.transform = '';
      exploreBtn.setAttribute('aria-expanded', 'false');
      deactivateCategory();
    }

    let closeTimer: ReturnType<typeof setTimeout>;
    exploreNavItem.addEventListener('mouseenter', () => { clearTimeout(closeTimer); openExploreMenu(); });
    exploreNavItem.addEventListener('mouseleave', () => { closeTimer = setTimeout(closeExploreMenu, 150); });
    exploreBtn.addEventListener('click', () => exploreMenu.classList.contains('hidden') ? openExploreMenu() : closeExploreMenu());
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeExploreMenu(); });
  }

  // Tools dropdown
  const toolsBtn = document.getElementById('tools-btn');
  const toolsMenu = document.getElementById('tools-menu');
  const toolsChevron = document.getElementById('tools-chevron');
  const toolsNav = document.getElementById('tools-nav');

  if (toolsBtn && toolsMenu && toolsChevron && toolsNav) {
    let toolsCloseTimer: ReturnType<typeof setTimeout>;

    function openTools() { toolsMenu.classList.remove('hidden'); toolsChevron.style.transform = 'rotate(180deg)'; toolsBtn.setAttribute('aria-expanded', 'true'); }
    function closeTools() { toolsMenu.classList.add('hidden'); toolsChevron.style.transform = ''; toolsBtn.setAttribute('aria-expanded', 'false'); }

    toolsNav.addEventListener('mouseenter', () => { clearTimeout(toolsCloseTimer); openTools(); });
    toolsNav.addEventListener('mouseleave', () => { toolsCloseTimer = setTimeout(closeTools, 150); });
    toolsBtn.addEventListener('click', () => toolsMenu.classList.contains('hidden') ? openTools() : closeTools());
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeTools(); });
  }

  // Mobile menu
  const mobileMenuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenuClose = document.getElementById('mobile-menu-close');
  const mobileMenu = document.getElementById('mobile-menu');

  if (mobileMenuBtn && mobileMenuClose && mobileMenu) {
    mobileMenuBtn.addEventListener('click', () => { mobileMenu.classList.remove('hidden'); document.body.style.overflow = 'hidden'; });
    mobileMenuClose.addEventListener('click', () => { mobileMenu.classList.add('hidden'); document.body.style.overflow = ''; });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') { mobileMenu.classList.add('hidden'); document.body.style.overflow = ''; } });
  }
</script>
