---
// The site's own position on a procedure, shown above the article. It is
// deliberately not a blockquote: prose styles render those italic and in
// quotation marks, which made the site's view read like a quote from someone
// else. It is also independent of the tool CTA rollout, so switching promotion
// off can never switch the stance off with it.
interface Props { text: string }
const { text } = Astro.props;
// **bold** is the only markup supported; everything else renders as plain text.
const parts = text.split(/\*\*(.+?)\*\*/);
---
<aside class="not-prose mb-12 rounded-2xl border border-amber-400/30 bg-amber-950/20 p-6 sm:p-7" aria-label="Where we stand">
  <p class="mb-2 text-xs font-bold uppercase tracking-widest text-amber-300">Where we stand</p>
  <p class="text-base leading-relaxed text-[#ddd]">{parts.map((part, i) => i % 2 ? <strong class="text-white">{part}</strong> : part)}</p>
</aside>
