---
const features = [
  {
    emoji: "🧬",
    tag: "Face Analysis",
    title: "Get Your PSL Score",
    description: "Upload your photo and receive a detailed face analysis — bone structure, facial ratios, and a personalized improvement roadmap.",
    stat: "PSL 5.8 → 7.3",
    color: "from-purple-600/20 to-violet-900/10",
    border: "border-purple-500/20",
  },
  {
    emoji: "✂️",
    tag: "Hairstyle Try-On",
    title: "Find Your Perfect Cut",
    description: "Try dozens of hairstyles matched to your exact face shape — oval, square, round, or diamond — before stepping into a barbershop.",
    stat: "50+ styles",
    color: "from-fuchsia-600/20 to-purple-900/10",
    border: "border-fuchsia-500/20",
  },
  {
    emoji: "🌅",
    tag: "Glow Up Routine",
    title: "Your Daily Routine, Personalized",
    description: "Morning and night routines built specifically for your skin type, goals, and schedule. Track streaks and watch your ratings climb.",
    stat: "Daily progress",
    color: "from-violet-600/20 to-purple-900/10",
    border: "border-violet-500/20",
  },
  {
    emoji: "💬",
    tag: "AI Coach",
    title: "AI Looksmaxxing Assistant",
    description: "Ask anything — jawline exercises, skincare stacks, style advice. Your personal looksmaxxing coach is available 24/7.",
    stat: "24/7 available",
    color: "from-purple-700/20 to-fuchsia-900/10",
    border: "border-purple-400/20",
  },
];
---

<section class="py-24 px-4">
  <div class="max-w-6xl mx-auto">
    <div class="text-center mb-16">
      <p class="text-purple-400 text-sm font-bold uppercase tracking-widest mb-4">What you get</p>
      <h2 class="text-4xl md:text-5xl font-black text-white leading-tight">
        Everything you need to<br />
        <span class="bg-gradient-to-r from-fuchsia-400 to-violet-400 bg-clip-text text-transparent">
          max your looks
        </span>
      </h2>
    </div>

    <div class="grid md:grid-cols-2 gap-5">
      {features.map((f) => (
        <div class={`relative rounded-2xl border ${f.border} bg-gradient-to-br ${f.color} p-7 overflow-hidden group`}>
          <!-- Glow -->
          <div class="absolute -top-10 -right-10 w-40 h-40 rounded-full bg-purple-500/5 blur-2xl group-hover:bg-purple-500/10 transition-all duration-500"></div>

          <div class="relative">
            <div class="flex items-center justify-between mb-5">
              <span class="text-3xl">{f.emoji}</span>
              <span class="text-xs font-bold uppercase tracking-widest text-purple-400 bg-purple-500/10 px-3 py-1 rounded-full border border-purple-500/20">
                {f.tag}
              </span>
            </div>
            <h3 class="text-xl font-black text-white mb-3">{f.title}</h3>
            <p class="text-[#888] text-sm leading-relaxed mb-6">{f.description}</p>
            <div class="inline-flex items-center gap-2 bg-white/5 border border-white/10 rounded-full px-4 py-1.5">
              <span class="w-1.5 h-1.5 rounded-full bg-purple-400 animate-pulse"></span>
              <span class="text-white text-xs font-semibold">{f.stat}</span>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
