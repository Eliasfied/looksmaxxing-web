---
const APP_URL = import.meta.env.PUBLIC_APP_URL ?? 'https://app.aura-looksmaxxing.com';
const plans = [
  { name: 'One report', price: '2.99', period: 'once', text: 'Start with one useful result. No recurring charge.', features: ['Free potential preview before signup', 'Unlock your complete tool report', 'Reopen your report from your account', '5 credits for one complete tool report'], primary: true },
  { name: 'Monthly', price: '9.99', period: '/ month', text: 'For regular reports and hairstyle experiments.', features: ['100 credits each month', 'Tool report unlock: 5 credits', 'Hairstyle try-on: 2 credits', 'Renews monthly until cancelled'] },
  { name: 'Yearly', price: '49.99', period: '/ year', text: 'Billed yearly. About $4.17 per month.', features: ['100 credits each month', 'Up to 20 reports, or a mix with try-ons', 'Unused monthly credits do not roll over', 'Renews yearly until cancelled'] },
];
---
<section class="px-6 py-16"><div class="max-w-6xl mx-auto">
  <div class="text-center mb-10"><p class="text-sm text-fuchsia-300 mb-3">Preview first. Decide afterwards.</p><h2 class="text-4xl font-black">Start with $2.99 once.</h2><p class="mt-4 text-[#999]">An ongoing plan is there when you need it.</p></div>
  <div class="grid gap-5 md:grid-cols-3">{plans.map(plan => <div class:list={['relative rounded-2xl border p-7 flex flex-col', plan.primary ? 'border-fuchsia-400/40 bg-gradient-to-br from-fuchsia-950/30 to-violet-950/20' : 'border-white/10 bg-[#101010]']}><h3 class="text-xl font-bold">{plan.name}</h3><p class="my-5"><span class="text-5xl font-black">${plan.price}</span><span class="ml-2 text-sm text-[#888]">{plan.period}</span></p><p class="text-sm text-[#aaa] mb-6">{plan.text}</p><ul class="space-y-3 text-sm text-[#aaa] mb-8 flex-1">{plan.features.map(feature => <li>✓ {feature}</li>)}</ul><a href={`${APP_URL}/tools/ai-face-rating?source=%2Fpricing`} class="btn-gradient rounded-xl px-5 py-3 text-center font-bold">Start with a free preview →</a></div>)}</div>
  <p class="mt-6 text-center text-xs text-[#888]">Choose your purchase after your preview and account creation. Checkout shows the final price and any applicable taxes.</p>
</div></section>
