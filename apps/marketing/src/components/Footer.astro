---
const BRAND_NAME = import.meta.env.PUBLIC_BRAND_NAME ?? 'Aura: Looksmaxxing';
const APP_URL = import.meta.env.PUBLIC_APP_URL ?? '#';
---

<footer class="border-t border-[#111] bg-black">
  <div class="max-w-6xl mx-auto px-4 py-16">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-10 mb-14">

      <!-- Brand -->
      <div class="col-span-2 md:col-span-1">
        <a href="/" class="flex items-center gap-2 text-base font-black text-white mb-3">
          <img src="/logo.webp" alt={BRAND_NAME} width="24" height="24" class="rounded-md" />
          {BRAND_NAME}
        </a>
        <p class="text-[#555] text-sm leading-relaxed max-w-xs">
          AI-powered looksmaxxing. Face analysis, hairstyle try-on, glow-up routines, and your personal AI coach.
        </p>
      </div>

      <!-- Features -->
      <div>
        <h3 class="text-white font-bold text-sm mb-5">Features</h3>
        <ul class="space-y-3">
          {[
            "Face Rating (PSL Score)",
            "Hairstyle Try-On",
            "Glow Up Routine",
            "AI Looksmaxxing Coach",
            "Bone Structure Analysis",
          ].map((f) => (
            <li><a href={`${APP_URL}/register`} class="text-[#555] hover:text-white transition-colors text-sm">{f}</a></li>
          ))}
        </ul>
      </div>

      <!-- Product -->
      <div>
        <h3 class="text-white font-bold text-sm mb-5">Product</h3>
        <ul class="space-y-3">
          {[
            { label: "Pricing", href: "/pricing" },
            { label: "FAQ", href: "/faq" },
            { label: "About", href: "/about" },
            { label: "Login", href: `${APP_URL}/login` },
            { label: "Sign Up Free", href: `${APP_URL}/register` },
          ].map((l) => (
            <li><a href={l.href} class="text-[#555] hover:text-white transition-colors text-sm">{l.label}</a></li>
          ))}
        </ul>
      </div>

      <!-- Legal -->
      <div>
        <h3 class="text-white font-bold text-sm mb-5">Legal</h3>
        <ul class="space-y-3">
          {[
            { label: "Privacy Policy", href: "/privacy" },
            { label: "Terms of Service", href: "/terms" },
          ].map((l) => (
            <li><a href={l.href} class="text-[#555] hover:text-white transition-colors text-sm">{l.label}</a></li>
          ))}
        </ul>
      </div>

    </div>

    <div class="pt-6 border-t border-[#111] flex flex-col sm:flex-row justify-between items-center gap-3 text-[#444] text-xs">
      <span>© {new Date().getFullYear()} {BRAND_NAME}. All rights reserved.</span>
      <div class="flex gap-5">
        <a href="/privacy" class="hover:text-white transition-colors">Privacy</a>
        <a href="/terms" class="hover:text-white transition-colors">Terms</a>
      </div>
    </div>
  </div>
</footer>
