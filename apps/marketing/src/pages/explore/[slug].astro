---
import BaseLayout from '../../layouts/BaseLayout.astro';
import exploreData from '../../data/explore-packs.json';
import faqData from '../../data/faq.json';
import PricingSection from '../../components/PricingSection.astro';
import HowItWorksSection from '../../components/HowItWorksSection.astro';
import TestimonialsSection from '../../components/TestimonialsSection.astro';

const BRAND_NAME = import.meta.env.PUBLIC_BRAND_NAME ?? 'Aura: Looksmaxxing';
const APP_URL = import.meta.env.PUBLIC_APP_URL;
const SITE_URL = import.meta.env.PUBLIC_SITE_URL ?? 'https://www.aura-looksmaxxing.com';

export function getStaticPaths() {
  return (exploreData as any[]).map(pack => ({
    params: { slug: pack.slug },
    props: { pack },
  }));
}

const { pack } = Astro.props;

const relatedPacks = (exploreData as any[]).filter(p => pack.related?.includes(p.slug));

// Placeholder gradient colors for missing images
const gradients = [
  "from-violet-600 to-purple-900",
  "from-pink-600 to-rose-900",
  "from-blue-600 to-indigo-900",
  "from-cyan-600 to-blue-900",
  "from-green-600 to-emerald-900",
  "from-orange-600 to-red-900",
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": (faqData as any[]).map(f => ({
    "@type": "Question",
    "name": f.question,
    "acceptedAnswer": { "@type": "Answer", "text": f.answer },
  })),
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": SITE_URL },
    { "@type": "ListItem", "position": 2, "name": "Explore", "item": `${SITE_URL}/explore` },
    { "@type": "ListItem", "position": 3, "name": pack.h1, "item": `${SITE_URL}/explore/${pack.slug}` },
  ],
};
---

<BaseLayout title={pack.meta_title} description={pack.meta_description}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  </Fragment>

  <!-- HERO -->
  <section class="relative overflow-hidden">
    <div class="pointer-events-none absolute inset-0">
      <div class="absolute -top-40 left-1/2 h-[600px] w-[600px] -translate-x-1/2 rounded-full bg-purple-600/10 blur-[140px]"></div>
      <div class="absolute top-20 right-0 h-[400px] w-[400px] rounded-full bg-fuchsia-600/5 blur-[120px]"></div>
    </div>

    <div class="relative max-w-6xl mx-auto px-4 pt-16 pb-12">
      <div class="flex flex-col gap-10">

        <!-- Top row: text left + signup right -->
        <div class="flex flex-col lg:flex-row lg:items-center gap-16">

          <!-- Left: H1 + subtitle + long text -->
          <div class="flex-1">
            {pack.badge && (
              <span class="inline-block btn-gradient text-white text-xs font-bold px-3 py-1 rounded-full mb-5">{pack.badge}</span>
            )}
            <h1 class="text-4xl md:text-5xl font-black text-white leading-tight mb-4">{pack.h1}</h1>
            <p class="text-lg text-[#aaa] mb-6">{pack.subtitle}</p>
            <div class="text-[#666] text-sm leading-relaxed space-y-4">
              {(pack.long_description || pack.intro).split('\n\n').map((para: string) => (
                <p>{para}</p>
              ))}
            </div>
          </div>

          <!-- Right: signup widget -->
          <div class="lg:w-[440px] flex-shrink-0 flex flex-col gap-3">
            <h2 class="text-3xl md:text-4xl font-black text-white leading-tight mb-1">
              Generate Stunning<br />
              <span class="bg-gradient-to-r from-fuchsia-400 to-violet-400 bg-clip-text text-transparent">{pack.hero_title || pack.h1}</span>
            </h2>
            <p class="text-gray-400 text-base mb-2">{pack.subtitle}</p>
            <div class="flex gap-3">
              <input
                type="email"
                placeholder="Enter your email"
                class="flex-1 bg-white/5 border border-white/10 rounded-full px-5 py-3 text-white placeholder-gray-500 focus:outline-none focus:border-purple-500 transition-colors text-sm"
              />
              <a
                href={`${APP_URL}/register`}
                class="btn-gradient text-white font-bold px-6 py-3 rounded-full hover:opacity-90 transition-opacity whitespace-nowrap text-sm"
              >
                Start creating →
              </a>
            </div>
            <div class="flex items-center gap-3">
              <div class="flex-1 h-px bg-white/10"></div>
              <span class="text-gray-500 text-xs">or</span>
              <div class="flex-1 h-px bg-white/10"></div>
            </div>
            <a
              href={`${APP_URL}/register`}
              class="flex items-center justify-center gap-3 bg-white text-gray-800 font-semibold px-5 py-3 rounded-full hover:bg-gray-100 transition-colors text-sm"
            >
              <svg class="h-4 w-4" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4" />
                <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853" />
                <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l3.66-2.84z" fill="#FBBC05" />
                <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335" />
              </svg>
              Continue with Google
            </a>
          </div>

        </div>

        <!-- Bottom row: full-width image gallery -->
        <div class="grid grid-cols-3 gap-3">
          <!-- Big left -->
          <div class={`aspect-[3/4] rounded-2xl overflow-hidden bg-gradient-to-br ${gradients[0]} shadow-lg`}>
            <img src={pack.example_images[0]?.src} alt={pack.example_images[0]?.alt} class="w-full h-full object-cover" onerror="this.style.display='none'" />
          </div>
          <!-- 2x2 grid (middle) -->
          <div class="grid grid-cols-2 gap-3">
            {pack.example_images.slice(1, 5).map((img: any, i: number) => (
              <div class={`aspect-[3/4] rounded-2xl overflow-hidden bg-gradient-to-br ${gradients[(i + 1) % gradients.length]} shadow-lg`}>
                <img src={img.src} alt={img.alt} class="w-full h-full object-cover" onerror="this.style.display='none'" />
              </div>
            ))}
          </div>
          <!-- Big right -->
          <div class={`aspect-[3/4] rounded-2xl overflow-hidden bg-gradient-to-br ${gradients[5]} shadow-lg`}>
            <img src={pack.example_images[5]?.src} alt={pack.example_images[5]?.alt} class="w-full h-full object-cover" onerror="this.style.display='none'" />
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- TESTIMONIALS -->
  {pack.testimonials && pack.testimonials.length > 0 && (
    <TestimonialsSection testimonials={pack.testimonials} />
  )}

  <!-- HOW IT WORKS -->
  <HowItWorksSection />

  <!-- FAQ -->
  <section class="max-w-3xl mx-auto px-4 py-16">
    <h2 class="text-2xl md:text-3xl font-black text-white text-center mb-10">Frequently asked questions</h2>

    <div class="space-y-3">
      {(faqData as any[]).map(item => (
        <details class="group bg-[#111111] rounded-2xl overflow-hidden">
          <summary class="flex items-center justify-between px-7 py-5 cursor-pointer list-none hover:bg-[#161616] transition-colors">
            <span class="text-white font-bold">{item.question}</span>
            <span class="text-[#555] text-2xl ml-6 flex-shrink-0 group-open:rotate-45 transition-transform">+</span>
          </summary>
          <div class="px-7 pb-6 pt-1 space-y-4">
            {item.answer.split('\n\n').map((para: string) => (
              <p class="text-[#888888] text-base leading-relaxed">{para}</p>
            ))}
          </div>
        </details>
      ))}
    </div>
  </section>

  <!-- PRICING -->
  <PricingSection />

  <!-- BOTTOM CTA -->
  <section class="bg-[#080808] border-y border-white/5 py-16">
    <div class="max-w-2xl mx-auto px-4 text-center">
      <h2 class="text-3xl md:text-4xl font-black text-white mb-8">{pack.cta_headline}</h2>
      <div class="flex flex-col sm:flex-row gap-3 justify-center">
        <a
          href={`${APP_URL}/register`}
          class="btn-gradient text-white font-bold px-8 py-4 rounded-full text-base hover:opacity-90 transition-opacity"
        >
          Start generating now →
        </a>
        <a
          href={`${APP_URL}/register`}
          class="flex items-center justify-center gap-3 bg-white text-gray-800 font-semibold px-6 py-4 rounded-full hover:bg-gray-100 transition-colors text-base"
        >
          <svg class="h-4 w-4" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4" />
            <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853" />
            <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l3.66-2.84z" fill="#FBBC05" />
            <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335" />
          </svg>
          Continue with Google
        </a>
      </div>
    </div>
  </section>

  <!-- RELATED -->
  {relatedPacks.length > 0 && (
    <section class="max-w-6xl mx-auto px-4 pt-16 pb-20">
      <h2 class="text-xl font-bold text-white mb-6">More styles you might like</h2>
      <div class="grid sm:grid-cols-2 gap-4">
        {relatedPacks.map((related: any) => (
          <a
            href={`/explore/${related.slug}`}
            class="bg-white rounded-2xl p-6 hover:bg-gray-50 transition-colors group"
          >
            <div class="flex items-center justify-between">
              <div>
                {related.badge && (
                  <span class="inline-block btn-gradient text-white text-xs font-bold px-2.5 py-0.5 rounded-full mb-2">{related.badge}</span>
                )}
                <h3 class="text-black font-bold group-hover:text-black/70 transition-colors">{related.h1}</h3>
                <p class="text-gray-400 text-sm mt-1">{related.stat}</p>
              </div>
              <span class="text-gray-400 group-hover:text-black transition-colors text-xl">→</span>
            </div>
          </a>
        ))}
      </div>
    </section>
  )}
</BaseLayout>
