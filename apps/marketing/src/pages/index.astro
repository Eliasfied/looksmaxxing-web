---
import BaseLayout from '../layouts/BaseLayout.astro';
import PricingSection from '../components/PricingSection.astro';
import HowItWorksSection from '../components/HowItWorksSection.astro';
import TestimonialsSection from '../components/TestimonialsSection.astro';

const BRAND_NAME = import.meta.env.PUBLIC_BRAND_NAME ?? '{{BRAND_NAME}}';
const APP_URL = import.meta.env.PUBLIC_APP_URL;
const SITE_URL = import.meta.env.PUBLIC_SITE_URL ?? 'https://yourdomain.com';

const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "@id": `${SITE_URL}/#organization`,
  "name": BRAND_NAME,
  "url": SITE_URL,
  "logo": {
    "@type": "ImageObject",
    "url": `${SITE_URL}/logo.png`,
    "width": 512,
    "height": 512,
  },
  "email": `support@${new URL(SITE_URL).hostname}`,
};

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": `${SITE_URL}/#website`,
  "name": BRAND_NAME,
  "url": SITE_URL,
};

const softwareSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "@id": `${SITE_URL}/#software`,
  "name": BRAND_NAME,
  "applicationCategory": "MultimediaApplication",
  "operatingSystem": "Web",
  "url": APP_URL,
  "description": "AI image generator for portraits, headshots, avatars, and more.",
  "offers": {
    "@type": "AggregateOffer",
    "lowPrice": "19.00",
    "highPrice": "99.00",
    "priceCurrency": "USD",
    "offerCount": "3",
    "url": `${SITE_URL}/pricing`,
  },
};
---

<BaseLayout
  title={`${BRAND_NAME} - Generate Stunning AI Images Instantly`}
  description={`AI image generator. Professional headshots, portraits, and avatars in 30 seconds. Plans from $19/mo.`}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(softwareSchema)} />
  </Fragment>

  <!-- HERO -->
  <section class="relative overflow-hidden">
    <div class="pointer-events-none absolute inset-0">
      <div class="absolute -top-40 left-1/2 h-[600px] w-[600px] -translate-x-1/2 rounded-full bg-purple-600/10 blur-[140px]"></div>
    </div>

    <div class="relative max-w-6xl mx-auto px-4 pt-20 pb-10">
      <div class="flex flex-col items-center text-center">
        <h1 class="text-5xl md:text-6xl lg:text-7xl font-black text-white leading-[1.05] mb-6">
          Generate<br />
          <span class="bg-gradient-to-r from-fuchsia-400 to-violet-400 bg-clip-text text-transparent">
            stunning
          </span><br />
          AI images
        </h1>

        <p class="text-lg text-gray-400 mb-8 max-w-md">
          Portraits, headshots, anime, landscapes. Create anything you imagine in seconds.
        </p>

        <div class="flex flex-col gap-3 max-w-md w-full mb-6">
          <div class="flex gap-3">
            <input
              type="email"
              placeholder="Enter your email"
              class="flex-1 bg-white/5 border border-white/10 rounded-full px-5 py-3 text-white placeholder-gray-500 focus:outline-none focus:border-purple-500 transition-colors text-sm"
            />
            <a
              href={`${APP_URL}/register`}
              class="btn-gradient text-white font-bold px-6 py-3 rounded-full hover:opacity-90 transition-opacity whitespace-nowrap text-sm"
            >
              Start Creating →
            </a>
          </div>

          <div class="flex items-center gap-3">
            <div class="flex-1 h-px bg-white/10"></div>
            <span class="text-gray-500 text-xs">or</span>
            <div class="flex-1 h-px bg-white/10"></div>
          </div>

          <a
            href={`${APP_URL}/register`}
            class="flex items-center justify-center gap-3 bg-white text-gray-800 font-semibold px-5 py-3 rounded-full hover:bg-gray-100 transition-colors text-sm"
          >
            <svg class="h-4 w-4" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4" />
              <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853" />
              <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l3.66-2.84z" fill="#FBBC05" />
              <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335" />
            </svg>
            Continue with Google
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- HOW IT WORKS -->
  <HowItWorksSection />

  <!-- TESTIMONIALS -->
  <TestimonialsSection
    title="What our customers say"
    testimonials={[
      { stars: 5, text: "The results were incredible. Generated variations in under 10 minutes and the quality was outstanding.", author: "Sarah K.", verified: true },
      { stars: 5, text: "Never thought AI photos could look this real. People were asking which photographer I used.", author: "Marcus T.", verified: true },
      { stars: 5, text: "Saves me so much time and money. The quality is honestly better than some professional sessions I've had.", author: "Emma R.", verified: true },
    ]}
  />

  <!-- PRICING -->
  <PricingSection />
</BaseLayout>
