---
import BaseLayout from '../layouts/BaseLayout.astro';
import PricingSection from '../components/PricingSection.astro';
import { toolCatalog, toolHref } from '../../../../config/tool-routing.mjs';
const appUrl = import.meta.env.PUBLIC_APP_URL ?? 'https://app.aura-looksmaxxing.com';
const featured = toolCatalog.filter(t => ['ai-face-rating', 'haircut-recommendation-tool', 'glow-up-planner'].includes(t.slug));
---
<BaseLayout title="Aura: Looksmaxxing – AI Face Analysis & Looksmaxxing Coach" description="Explore your features, find haircut ideas and build a personal glow-up plan. Upload a selfie for a free potential preview; unlock your report for $2.99 once.">
  <section class="relative overflow-hidden"><div class="absolute pointer-events-none -top-36 right-0 h-[600px] w-[600px] rounded-full bg-purple-800/20 blur-[140px]"></div>
    <div class="relative max-w-6xl mx-auto px-6 py-20 grid gap-14 lg:grid-cols-2 lg:items-center">
      <div><p class="text-fuchsia-300 font-bold text-xs uppercase tracking-[.2em]">Your photo. Your style. Your next step.</p>
        <h1 class="mt-6 text-5xl sm:text-7xl font-black leading-[1.03]">See your<br /><span class="bg-gradient-to-r from-fuchsia-400 to-violet-400 bg-clip-text text-transparent">potential.</span><br />Make it personal.</h1>
        <p class="mt-6 max-w-xl text-lg text-[#aaa] leading-relaxed">Understand your features, explore haircut ideas and turn your goals into a practical routine. Start with a selfie and your preferences.</p>
        <div class="mt-8 flex flex-wrap gap-4"><a href={toolHref('ai-face-rating', '/', appUrl)} data-tool="ai-face-rating" data-placement="home-hero" class="btn-gradient rounded-xl px-7 py-4 font-bold">Upload photo & see my potential →</a><a href="/tools" class="rounded-xl border border-white/15 px-7 py-4 font-bold">Explore tools</a></div>
        <p class="mt-4 text-sm text-[#888]">No signup to start · Free potential preview · Full report $2.99</p>
      </div>
      <div class="rounded-3xl border border-white/10 bg-[#100d17] p-7 sm:p-9 shadow-2xl shadow-purple-950/30">
        <div class="flex justify-between text-sm"><span class="font-bold">Aura<span class="text-fuchsia-300">.</span></span><span class="text-[#777]">Report preview example</span></div>
        <div class="my-7 rounded-2xl bg-gradient-to-br from-fuchsia-700/20 to-violet-600/20 p-7 text-center"><p class="text-[#bbb] text-sm">Estimated styling potential</p><p class="text-6xl font-black mt-3">8.4<span class="text-2xl text-[#777]"> / 10</span></p><p class="mt-3 text-xs text-[#888]">Illustration only. Your result will be personal.</p></div>
        {['Your facial profile', 'Hair & styling suggestions', 'Your next steps'].map(label => <div class="border-t border-white/10 py-4"><div class="flex justify-between gap-3"><span class="font-bold">{label}</span><span class="text-[#888] text-xs">Locked</span></div><div aria-hidden="true" class="mt-3 h-3 rounded bg-white/15 blur-sm w-4/5"></div></div>)}
        <a href={toolHref('ai-face-rating', '/', appUrl)} class="mt-4 block rounded-xl border border-fuchsia-400/30 p-3 text-center text-fuchsia-200 text-sm">Create my own preview →</a>
      </div>
    </div>
  </section>
  <section class="max-w-6xl mx-auto px-6 py-12"><div class="flex flex-wrap justify-between gap-4 items-end"><div><p class="text-xs text-fuchsia-300 uppercase tracking-widest">Choose your starting point</p><h2 class="text-3xl sm:text-4xl font-black mt-3">What would you like to explore?</h2></div><a href="/tools" class="text-fuchsia-300">All tools →</a></div><div class="mt-8 grid gap-5 md:grid-cols-3">{featured.map((tool, i) => <a href={`/tools/${tool.slug}`} class="group rounded-2xl border border-white/10 bg-[#101010] p-7 hover:border-fuchsia-400/40"><span class="text-fuchsia-300 text-xs">0{i + 1}</span><h3 class="mt-4 text-2xl font-bold">{tool.name}</h3><p class="mt-3 text-[#aaa] leading-relaxed">{tool.description}</p><p class="mt-7 text-fuchsia-300 font-bold text-sm">Explore this tool →</p></a>)}</div></section>
  <section class="max-w-6xl mx-auto px-6 py-12"><div class="rounded-3xl border border-fuchsia-400/20 bg-gradient-to-r from-fuchsia-950/30 to-violet-950/20 p-8 sm:p-12 grid gap-8 md:grid-cols-2"><div><p class="text-xs uppercase tracking-widest text-fuchsia-300">For women, too</p><h2 class="mt-4 text-3xl sm:text-4xl font-black">Your goals set the direction.</h2><p class="mt-4 text-[#aaa] leading-relaxed">Explore hair framing, brow styling and optional makeup ideas. Choose the style you want, with suggestions that respect your preferences.</p></div><div class="flex flex-col gap-4 justify-center"><a href="/tools/face-analysis-for-women" class="rounded-xl border border-white/15 p-5 font-bold hover:bg-white/5">Face analysis for women →</a><a href="/tools/hairstyle-finder-for-women" class="rounded-xl border border-white/15 p-5 font-bold hover:bg-white/5">Find your next haircut →</a><a href="/blog/looksmaxxing-for-women" class="text-sm text-fuchsia-300">Read the women's guide →</a></div></div></section>
  <section class="max-w-6xl mx-auto px-6 py-12"><h2 class="text-3xl font-black">A small first step.</h2><ol class="mt-8 grid gap-8 md:grid-cols-3">{[['Upload a photo', 'Choose a tool and tell us what you want to explore. No account needed.'], ['See your potential', 'Your free preview shows a subjective styling-potential estimate.'], ['Unlock when you want', 'Create an account and pay $2.99 once for the full report. Subscriptions are optional.']].map(([title, text], i) => <li><span class="text-fuchsia-300">0{i + 1}</span><h3 class="mt-3 text-xl font-bold">{title}</h3><p class="mt-3 text-[#aaa] leading-relaxed">{text}</p></li>)}</ol></section>
  <PricingSection />
  <section class="max-w-3xl mx-auto px-6 py-12 text-center"><h2 class="text-2xl font-bold">A perspective you can use.</h2><p class="mt-4 text-[#999] leading-relaxed">Aura offers subjective AI styling suggestions. A photo score does not measure your worth, diagnose a condition or predict how your appearance will change. Good light and a clear photo help make the report useful.</p><a href="/blog" class="inline-block mt-5 text-fuchsia-300">Explore the guides →</a></section>
</BaseLayout>
