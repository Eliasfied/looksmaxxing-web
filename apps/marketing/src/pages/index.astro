---
import BaseLayout from '../layouts/BaseLayout.astro';
import PricingSection from '../components/PricingSection.astro';
import TestimonialsSection from '../components/TestimonialsSection.astro';
import faqDataRaw from '../data/faq.json';
const faqData = faqDataRaw as Array<{ slug: string; question: string; answer: string }>;

const BRAND_NAME = import.meta.env.PUBLIC_BRAND_NAME ?? 'Aura: Looksmaxxing';
const APP_URL = import.meta.env.PUBLIC_APP_URL ?? '#';
const SITE_URL = import.meta.env.PUBLIC_SITE_URL ?? 'https://looksmaxxing.ai';

const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "@id": `${SITE_URL}/#organization`,
  "name": BRAND_NAME,
  "url": SITE_URL,
  "logo": { "@type": "ImageObject", "url": `${SITE_URL}/logo.png`, "width": 512, "height": 512 },
  "email": `support@${new URL(SITE_URL).hostname}`,
};

const softwareSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": BRAND_NAME,
  "applicationCategory": "HealthApplication",
  "operatingSystem": "Web",
  "description": "AI-powered looksmaxxing platform. Get your PSL score, try hairstyles, build a glow-up routine, and chat with your AI coach.",
};
---

<BaseLayout
  title={`${BRAND_NAME} – AI Face Analysis & Looksmaxxing Coach`}
  description="Get your PSL score, try hairstyles for your face shape, build a personalized glow-up routine, and chat with your AI looksmaxxing coach."
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(softwareSchema)} />
  </Fragment>

  <!-- ═══════════════════════════════════════════════════════════
       HERO
  ═══════════════════════════════════════════════════════════ -->
  <section class="relative overflow-hidden">
    <!-- Background -->
    <div class="pointer-events-none absolute inset-0">
      <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[900px] h-[600px] bg-purple-700/12 blur-[140px] rounded-full"></div>
      <div class="absolute bottom-0 right-0 w-[500px] h-[400px] bg-fuchsia-800/8 blur-[120px] rounded-full"></div>
      <img src="/logo.png" alt="" class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[700px] opacity-30 select-none" />
    </div>

    <div class="relative max-w-6xl mx-auto px-6 pt-20 pb-16 w-full">
      <div class="grid lg:grid-cols-2 gap-16 items-center">

        <!-- Left: Copy -->
        <div class="flex flex-col items-start">
          <div class="inline-flex items-center gap-2 bg-purple-500/10 border border-purple-500/20 rounded-full px-4 py-2 mb-8">
            <span class="w-1.5 h-1.5 bg-purple-400 rounded-full animate-pulse"></span>
            <span class="text-purple-300 text-xs font-bold tracking-widest uppercase">AI-Powered Looksmaxxing</span>
          </div>

          <h1 class="text-5xl md:text-6xl lg:text-7xl font-black text-white leading-[1.0] tracking-tight mb-6">
            Know Your<br />
            <span class="bg-gradient-to-r from-fuchsia-400 via-purple-400 to-violet-400 bg-clip-text text-transparent">
              Score.
            </span><br />
            Reach Your<br />
            <span class="bg-gradient-to-r from-violet-400 to-fuchsia-400 bg-clip-text text-transparent">
              Peak.
            </span>
          </h1>

          <p class="text-lg text-[#888] mb-10 max-w-lg leading-relaxed">
            Upload a selfie and get your PSL score, personalised hairstyle recommendations, a daily glow-up routine, and a 24/7 AI coach — everything to reach your potential.
          </p>

          <div class="flex flex-col sm:flex-row gap-3 w-full max-w-md">
            <a
              href={`${APP_URL}/register`}
              class="btn-gradient text-white font-bold px-8 py-4 rounded-full hover:opacity-90 transition-opacity text-base text-center"
            >
              Get My PSL Score →
            </a>
            <a
              href={`${APP_URL}/register`}
              class="flex items-center justify-center gap-2.5 bg-white/5 border border-white/10 text-white font-semibold px-6 py-4 rounded-full hover:bg-white/10 transition-colors text-sm"
            >
              <svg class="h-4 w-4 shrink-0" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4" />
                <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853" />
                <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l3.66-2.84z" fill="#FBBC05" />
                <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335" />
              </svg>
              Continue with Google
            </a>
          </div>

        </div>

        <!-- Right: App UI placeholder -->
        <div class="hidden lg:flex flex-col gap-3 items-center">

          <!-- Phone card outer -->
          <div class="w-full max-w-[320px] bg-[#0d0d0d] border border-white/10 rounded-3xl p-5 shadow-2xl shadow-purple-900/20">

            <!-- Header bar -->
            <div class="flex items-center justify-between mb-5">
              <span class="text-white font-black text-sm">Face Analysis</span>
              <div class="flex items-center gap-1.5">
                <div class="w-5 h-5 rounded-full bg-white/10 flex items-center justify-center">
                  <svg class="w-2.5 h-2.5 text-white/60" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 21v-4m0 0V5a2 2 0 012-2h6.5l1 1H21l-3 6 3 6h-8.5l-1-1H5a2 2 0 00-2 2zm9-13.5V9" /></svg>
                </div>
                <div class="w-5 h-5 rounded-full bg-purple-500/30 flex items-center justify-center">
                  <svg class="w-2.5 h-2.5 text-purple-300" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                </div>
              </div>
            </div>

            <!-- Photo placeholders -->
            <div class="grid grid-cols-2 gap-2 mb-5">
              <div class="aspect-square rounded-xl overflow-hidden border border-white/8">
                <img src="/images/hero/front.webp" alt="Front scan" class="w-full h-full object-cover" />
              </div>
              <div class="aspect-square rounded-xl overflow-hidden border border-white/8">
                <img src="/images/hero/side.webp" alt="Side scan" class="w-full h-full object-cover" />
              </div>
            </div>

            <!-- PSL Score -->
            <div class="bg-[#111] rounded-2xl p-4 mb-3 flex items-center gap-4">
              <div class="w-14 h-14 rounded-full bg-gradient-to-br from-fuchsia-500 to-violet-600 flex items-center justify-center text-white font-black text-xl shrink-0">5.8</div>
              <div>
                <p class="text-[#666] text-[10px] font-bold uppercase tracking-widest mb-0.5">PSL Score</p>
                <p class="text-white font-black text-lg leading-tight">5.8 / 10</p>
                <p class="text-[#555] text-[10px]">Face Score: 64/100</p>
              </div>
            </div>

            <!-- Potential score -->
            <div class="bg-green-500/10 border border-green-500/20 rounded-2xl p-4 mb-4 flex items-center gap-3">
              <div class="w-10 h-10 rounded-full bg-green-500/20 flex items-center justify-center text-green-400 font-black text-sm shrink-0">7.3</div>
              <div>
                <p class="text-green-400 text-[10px] font-bold uppercase tracking-widest mb-0.5">Potential Score</p>
                <p class="text-[#888] text-xs">You could reach 7.3 with the right routine</p>
              </div>
            </div>

            <!-- Bone structure bars -->
            <div class="space-y-3">
              <p class="text-[#555] text-[10px] font-bold uppercase tracking-widest">Bone Structure</p>
              {[
                { label: "Gonial Angle", score: 60, color: "bg-purple-500" },
                { label: "Midface Ratio", score: 65, color: "bg-fuchsia-500" },
                { label: "Jawline Width", score: 72, color: "bg-violet-500" },
              ].map(b => (
                <div>
                  <div class="flex justify-between mb-1">
                    <span class="text-[#666] text-[10px]">{b.label}</span>
                    <span class="text-white text-[10px] font-bold">{b.score}</span>
                  </div>
                  <div class="h-1.5 bg-white/5 rounded-full">
                    <div class={`h-full ${b.color} rounded-full`} style={`width: ${b.score}%`}></div>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════
       SCAN UPLOAD MOCKUP
  ═══════════════════════════════════════════════════════════ -->
  <section class="py-20 px-6 bg-[#050505] border-y border-white/5 relative overflow-hidden">
    <div class="pointer-events-none absolute inset-0">
      <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[700px] h-[400px] bg-purple-800/8 blur-[120px] rounded-full"></div>
    </div>

    <div class="relative max-w-5xl mx-auto">
      <!-- Heading -->
      <div class="text-center mb-12">
        <p class="text-purple-400 text-xs font-bold uppercase tracking-widest mb-4">How it starts</p>
        <h2 class="text-4xl md:text-5xl font-black text-white leading-tight">
          Upload your photos.<br />
          <span class="bg-gradient-to-r from-fuchsia-400 to-violet-400 bg-clip-text text-transparent">
            We handle the rest.
          </span>
        </h2>
        <p class="text-[#666] mt-4 text-sm max-w-sm mx-auto">Two photos. 30 seconds. A full breakdown of your face, your potential, and your path there.</p>
      </div>

      <!-- Upload cards -->
      <div class="grid md:grid-cols-2 gap-5 mb-8">

        <!-- Frontal Scan -->
        <div class="bg-[#0a0a0a] border border-purple-500/20 rounded-2xl p-6 relative overflow-hidden">
          <div class="absolute -top-8 -right-8 w-40 h-40 rounded-full bg-purple-500/6 blur-3xl"></div>
          <div class="relative">
            <!-- Card header -->
            <div class="flex items-center justify-between mb-4">
              <span class="text-white font-black text-sm tracking-wider uppercase">Frontal Scan</span>
              <span class="text-[10px] font-bold uppercase tracking-widest text-fuchsia-300 border border-fuchsia-500/40 bg-fuchsia-500/10 px-2.5 py-1 rounded-full">Required</span>
            </div>
            <p class="text-[#555] text-xs mb-5 leading-relaxed">Face the camera directly. Neutral expression, even lighting for maximum accuracy.</p>

            <!-- Upload zone -->
            <div class="relative rounded-xl border border-purple-500/30 aspect-[3/4] overflow-hidden">
              <img src="/images/scan/front.webp" alt="Frontal scan example" class="w-full h-full object-cover" />
              <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent flex flex-col items-center justify-end pb-4 gap-2">
                <div class="w-8 h-8 rounded-full border border-purple-500/60 bg-purple-500/20 flex items-center justify-center">
                  <svg class="w-4 h-4 text-purple-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5m-13.5-9L12 3m0 0l4.5 4.5M12 3v13.5" />
                  </svg>
                </div>
                <p class="text-white/70 text-[10px] font-semibold tracking-wider uppercase">Drag & drop or tap to browse</p>
              </div>
            </div>
          </div>
        </div>

        <!-- Side Scan -->
        <div class="bg-[#0a0a0a] border border-white/8 rounded-2xl p-6 relative overflow-hidden">
          <div class="absolute -top-8 -right-8 w-40 h-40 rounded-full bg-violet-500/5 blur-3xl"></div>
          <div class="relative">
            <!-- Card header -->
            <div class="flex items-center justify-between mb-4">
              <span class="text-white font-black text-sm tracking-wider uppercase">Side Scan</span>
              <span class="text-[10px] font-bold uppercase tracking-widest text-[#666] border border-white/10 bg-white/4 px-2.5 py-1 rounded-full">Optional</span>
            </div>
            <p class="text-[#555] text-xs mb-5 leading-relaxed">Turn 90° to the side. Lateral data enables precise bone structure modeling.</p>

            <!-- Upload zone -->
            <div class="relative rounded-xl border border-white/10 aspect-[3/4] overflow-hidden">
              <img src="/images/scan/side.webp" alt="Side scan example" class="w-full h-full object-cover" />
              <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent flex flex-col items-center justify-end pb-4 gap-2">
                <div class="w-8 h-8 rounded-full border border-white/30 bg-white/10 flex items-center justify-center">
                  <svg class="w-4 h-4 text-white/50" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5m-13.5-9L12 3m0 0l4.5 4.5M12 3v13.5" />
                  </svg>
                </div>
                <p class="text-white/70 text-[10px] font-semibold tracking-wider uppercase">Drag & drop or tap to browse</p>
              </div>
            </div>
          </div>
        </div>

      </div>

      <!-- CTA -->
      <div class="flex justify-center mt-8">
        <a
          href={`${APP_URL}/register`}
          class="btn-gradient text-white font-bold px-10 py-4 rounded-full hover:opacity-90 transition-opacity text-sm tracking-widest uppercase"
        >
          Start Face Scan →
        </a>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════
       FEATURES
  ═══════════════════════════════════════════════════════════ -->
  <section class="py-28 px-6 bg-[#050505] border-y border-white/5">
    <div class="max-w-6xl mx-auto">
      <div class="text-center mb-16">
        <p class="text-purple-400 text-xs font-bold uppercase tracking-widest mb-4">What you get</p>
        <h2 class="text-4xl md:text-5xl font-black text-white leading-tight">
          Every tool to<br />
          <span class="bg-gradient-to-r from-fuchsia-400 to-violet-400 bg-clip-text text-transparent">
            max your looks
          </span>
        </h2>
        <p class="text-[#666] mt-4 max-w-sm mx-auto text-sm">Four AI-powered features — one platform.</p>
      </div>

      <div class="grid md:grid-cols-2 gap-5">

        <!-- Face Analysis -->
        <div class="relative rounded-2xl border border-purple-500/20 bg-gradient-to-br from-purple-600/15 to-violet-900/5 p-7 overflow-hidden group">
          <div class="absolute -top-10 -right-10 w-48 h-48 rounded-full bg-purple-500/8 blur-3xl group-hover:bg-purple-500/15 transition-all duration-500"></div>
          <div class="relative">
            <div class="flex items-center justify-between mb-5">
              <span class="text-3xl">🧬</span>
              <span class="text-xs font-bold uppercase tracking-widest text-purple-400 bg-purple-500/10 px-3 py-1 rounded-full border border-purple-500/20">Face Analysis</span>
            </div>
            <h3 class="text-xl font-black text-white mb-2">Your PSL Score, Explained</h3>
            <p class="text-[#888] text-sm leading-relaxed mb-5">Upload your photo and get a full breakdown across every dimension of your face — plus a roadmap to your potential score.</p>

            <div class="bg-black/40 rounded-xl p-4 border border-white/6">
              <!-- Score row -->
              <div class="flex items-center gap-3 mb-3">
                <div class="w-10 h-10 rounded-full bg-gradient-to-br from-fuchsia-500 to-violet-600 flex items-center justify-center text-white font-black text-sm shrink-0">5.1</div>
                <div class="flex-1">
                  <div class="flex justify-between text-[10px] mb-1">
                    <span class="text-[#666]">PSL Score · Face Score: 62/100</span>
                    <span class="text-green-400 font-bold">↑ 6.7 potential</span>
                  </div>
                  <div class="h-1.5 bg-white/5 rounded-full">
                    <div class="h-full w-[51%] bg-gradient-to-r from-fuchsia-500 to-violet-500 rounded-full"></div>
                  </div>
                </div>
              </div>

              <!-- Categories grid -->
              <div class="grid grid-cols-2 gap-1.5">
                {[
                  { cat: "🦴 Bone Structure", items: "Gonial Angle · Midface · Cheekbones" },
                  { cat: "👁 Eye Area", items: "Canthal Tilt · Eyelid · IPD" },
                  { cat: "✨ Skin & Hair", items: "Skin Clarity · Hairline Depth" },
                  { cat: "⚖️ Symmetry", items: "Asymmetry Index" },
                ].map(({ cat, items }) => (
                  <div class="bg-white/4 rounded-lg px-2.5 py-2">
                    <p class="text-white text-[10px] font-bold mb-0.5">{cat}</p>
                    <p class="text-[#555] text-[9px] leading-snug">{items}</p>
                  </div>
                ))}
              </div>

              <!-- Tips row -->
              <div class="mt-1.5 bg-purple-500/8 border border-purple-500/15 rounded-lg px-2.5 py-2">
                <p class="text-[#555] text-[9px]">
                  <span class="text-purple-400 font-bold">💡 Recommendations — </span>
                  Style · Nutrition · Sleep · Exercise · Grooming · Posture
                </p>
              </div>
            </div>
          </div>
        </div>

        <!-- Hairstyle Try-On -->
        <div class="relative rounded-2xl border border-fuchsia-500/20 bg-gradient-to-br from-fuchsia-600/15 to-purple-900/5 p-7 overflow-hidden group">
          <div class="absolute -top-10 -right-10 w-48 h-48 rounded-full bg-fuchsia-500/8 blur-3xl group-hover:bg-fuchsia-500/15 transition-all duration-500"></div>
          <div class="relative">
            <div class="flex items-center justify-between mb-5">
              <span class="text-3xl">✂️</span>
              <span class="text-xs font-bold uppercase tracking-widest text-fuchsia-400 bg-fuchsia-500/10 px-3 py-1 rounded-full border border-fuchsia-500/20">Hairstyle Try-On</span>
            </div>
            <h3 class="text-xl font-black text-white mb-2">Find Your Perfect Cut</h3>
            <p class="text-[#888] text-sm leading-relaxed mb-5">Try 50+ hairstyles matched to your exact face shape and hairline. Walk into the barber knowing exactly what you want.</p>

            <!-- Hairstyle grid -->
            <div class="bg-black/40 rounded-xl p-4 border border-white/6">
              <p class="text-[#555] text-[10px] font-bold uppercase tracking-widest mb-3">Recommended for oval face</p>
              <div class="grid grid-cols-4 gap-2">
                {[
                  "Buzz Cut", "Curtains", "French Crop", "High Fade",
                  "Quiff", "Wolf Cut", "Low Taper", "Pompadour",
                ].map((name, i) => (
                  <div class={`aspect-square rounded-xl border overflow-hidden relative group ${i === 0 ? 'border-fuchsia-400/60 ring-1 ring-fuchsia-500/40' : 'border-white/8'}`}>
                    <img src={`/images/hairstyle/${name}.webp`} alt={name} class="w-full h-full object-cover" />
                    <div class="absolute inset-0 bg-black/50 opacity-0 group-hover:opacity-100 transition-opacity flex items-end justify-center pb-1">
                      <span class="text-white text-[8px] font-bold text-center px-1 leading-tight">{name}</span>
                    </div>
                    {i === 0 && <div class="absolute top-1 right-1 w-2 h-2 rounded-full bg-fuchsia-400"></div>}
                  </div>
                ))}
              </div>
              <p class="text-fuchsia-400 text-[10px] font-bold mt-3 text-center">+ 16 more styles available</p>
            </div>
          </div>
        </div>

        <!-- Glow-Up Routine -->
        <div class="relative rounded-2xl border border-violet-500/20 bg-gradient-to-br from-violet-600/15 to-purple-900/5 p-7 overflow-hidden group">
          <div class="absolute -top-10 -right-10 w-48 h-48 rounded-full bg-violet-500/8 blur-3xl group-hover:bg-violet-500/15 transition-all duration-500"></div>
          <div class="relative">
            <div class="flex items-center justify-between mb-5">
              <span class="text-3xl">🌅</span>
              <span class="text-xs font-bold uppercase tracking-widest text-violet-400 bg-violet-500/10 px-3 py-1 rounded-full border border-violet-500/20">Daily Routine</span>
            </div>
            <h3 class="text-xl font-black text-white mb-2">Your Personalized Glow-Up Plan</h3>
            <p class="text-[#888] text-sm leading-relaxed mb-5">Based on your scan, you get targeted tips to close the gap between your current score and your potential — no generic advice, just what works for your face.</p>

            <!-- Placeholder UI: tips list -->
            <div class="bg-black/40 rounded-xl p-4 border border-white/6 space-y-2.5">
              <p class="text-[#555] text-[10px] font-bold uppercase tracking-widest mb-3">Your tips to reach 7.3</p>
              {[
                { label: "Mew consistently — raises midface ratio over time", impact: "+0.4" },
                { label: "Fix your skincare — texture is dragging your score", impact: "+0.3" },
                { label: "Grow out your hair — softens jaw asymmetry", impact: "+0.2" },
                { label: "Bulk to fill your frame — adds facial structure", impact: "+0.4" },
              ].map(tip => (
                <div class="flex items-start gap-3 p-2 rounded-lg bg-white/3">
                  <span class="text-violet-400 font-black text-xs shrink-0 mt-0.5">{tip.impact}</span>
                  <span class="text-[#aaa] text-xs leading-relaxed">{tip.label}</span>
                </div>
              ))}
            </div>
          </div>
        </div>

        <!-- AI Coach -->
        <div class="relative rounded-2xl border border-purple-400/20 bg-gradient-to-br from-purple-700/15 to-fuchsia-900/5 p-7 overflow-hidden group">
          <div class="absolute -top-10 -right-10 w-48 h-48 rounded-full bg-purple-500/8 blur-3xl group-hover:bg-purple-500/15 transition-all duration-500"></div>
          <div class="relative">
            <div class="flex items-center justify-between mb-5">
              <span class="text-3xl">💬</span>
              <span class="text-xs font-bold uppercase tracking-widest text-purple-300 bg-purple-500/10 px-3 py-1 rounded-full border border-purple-400/20">AI Coach</span>
            </div>
            <h3 class="text-xl font-black text-white mb-2">Your Personal AI Looksmaxxing Coach</h3>
            <p class="text-[#888] text-sm leading-relaxed mb-5">Ask anything about skincare, jawline training, diet, grooming. Your coach is available 24/7 and knows your exact face data.</p>

            <!-- Placeholder UI: chat -->
            <div class="bg-black/40 rounded-xl p-4 border border-white/6 space-y-2.5">
              <div class="flex gap-2 items-end">
