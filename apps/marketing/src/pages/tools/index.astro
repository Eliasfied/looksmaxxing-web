---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const tools = (await getCollection('tools', ({ data }) => !data.draft))
  .sort((a, b) => a.data.title.localeCompare(b.data.title));
---

<BaseLayout
  title="Free Looksmaxxing Tools | PSL Calculator, Face Rating, Canthal Tilt | Aura"
  description="Free online tools to rate your face, calculate your PSL score, check your canthal tilt, find your face shape, and more. Built on AI computer vision."
>
  <section class="relative overflow-hidden">
    <div class="pointer-events-none absolute inset-0">
      <div class="absolute -top-40 left-1/2 h-[600px] w-[600px] -translate-x-1/2 rounded-full bg-purple-600/10 blur-[140px]"></div>
    </div>
    <div class="relative max-w-5xl mx-auto px-4 pt-20 pb-12">
      <h1 class="text-4xl md:text-6xl font-black text-white mb-4 leading-tight">
        Free Looksmaxxing <span class="bg-gradient-to-r from-fuchsia-400 to-violet-400 bg-clip-text text-transparent">Tools</span>
      </h1>
      <p class="text-lg text-[#aaa] max-w-2xl">
        Rate your face, find your PSL score, check your canthal tilt, and analyze your features. All powered by AI computer vision.
      </p>
    </div>
  </section>

  <section class="max-w-5xl mx-auto px-4 pb-24">
    {tools.length === 0 && (
      <p class="text-[#666] text-center py-16">No tools yet. Check back soon.</p>
    )}

    <div class="grid sm:grid-cols-2 gap-5">
      {tools.map(tool => (
        <a
          href={`/tools/${tool.data.slug}`}
          class="group bg-[#111] hover:bg-[#161616] rounded-2xl p-7 border border-white/5 hover:border-fuchsia-500/30 transition-all"
        >
          {tool.data.badge && (
            <span class="inline-block btn-gradient text-white text-xs font-bold px-3 py-1 rounded-full mb-4">{tool.data.badge}</span>
          )}
          <h2 class="text-white font-black text-2xl mb-2 leading-tight group-hover:text-fuchsia-400 transition-colors">
            {tool.data.h1}
          </h2>
          <p class="text-[#aaa] text-base leading-relaxed mb-5">{tool.data.subtitle}</p>
          <span class="inline-flex items-center gap-2 text-fuchsia-400 font-bold text-sm">
            Open the tool
            <span class="group-hover:translate-x-1 transition-transform">→</span>
          </span>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
