---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { toolCatalog, toolHref } from '../../../../../config/tool-routing.mjs';
const APP_URL = import.meta.env.PUBLIC_APP_URL ?? 'https://app.aura-looksmaxxing.com';
const freeTools = [
  { href: '/tools/face-shape-detector#free-preview', name: 'Face Shape Detector', text: 'Your likely face shape and what suits it.' },
  { href: '/tools/golden-ratio-face-calculator', name: 'Golden Ratio Face Calculator', text: 'Proportions, facial thirds, eye spacing and symmetry.' },
  { href: '/tools/eye-shape-detector', name: 'Eye Shape Detector', text: 'Eye shape, canthal tilt and spacing.' },
  { href: '/tools/symmetry-analyzer#free-preview', name: 'Face Symmetry Test', text: 'Left-right balance, corrected for head tilt.' },
];
const groups = [
  { title: 'Start with your goal', id: 'start', tools: toolCatalog.filter(t => t.priority <= 3 || t.slug === 'glow-up-planner') },
  { title: 'Made for your style: women', id: 'women', tools: toolCatalog.filter(t => t.audience === 'women') },
  { title: 'Explore a specific feature', id: 'features', tools: toolCatalog.filter(t => t.priority >= 7) },
];
---
<BaseLayout title="Looksmaxxing Tools: Upload a Photo, Get a Read | Aura" description="Face analysis, haircut ideas, a glow-up planner and a mewing tracker, for men and women. Free previews run on your device; full AI reports come with Aura Pro.">
  <header class="max-w-6xl mx-auto px-6 pt-20 pb-10">
    <p class="text-fuchsia-300 text-xs font-bold uppercase tracking-widest">The Aura toolkit</p>
    <h1 class="mt-4 text-4xl sm:text-6xl font-black max-w-3xl">Less guessing.<br /><span class="text-fuchsia-300">A look that feels like you.</span></h1>
    <p class="mt-6 text-lg text-[#aaa] max-w-2xl">Start with a photo. Your face shape, symmetry and eye geometry are measured free in your browser. Aura Pro writes the full AI report.</p>
    <p class="mt-3 text-sm text-[#888]">Free tools run on your device, no signup. Aura Pro from $4.17 a month.</p>
    <nav aria-label="Tool categories" class="mt-7 flex flex-wrap gap-3"><a href="#free" class="rounded-full border border-emerald-400/30 px-4 py-2 text-sm hover:border-emerald-300">Free tools</a>{groups.map(group => <a href={`#${group.id}`} class="rounded-full border border-white/15 px-4 py-2 text-sm hover:border-fuchsia-400">{group.title}</a>)}</nav>
  </header>
  <section id="free" class="max-w-6xl mx-auto px-6 py-10 scroll-mt-20"><div class="flex flex-wrap items-baseline justify-between gap-3 mb-6"><h2 class="text-2xl font-bold">Free tools, right in your browser</h2><span class="rounded-full border border-emerald-400/25 bg-emerald-400/10 px-3 py-1 text-xs font-semibold text-emerald-200">Photo never uploaded</span></div><div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">{freeTools.map(t => <a href={t.href} class="rounded-2xl border border-white/10 bg-gradient-to-br from-white/[0.04] to-transparent p-5 transition hover:border-fuchsia-400/40"><h3 class="font-bold">{t.name}</h3><p class="mt-2 text-sm text-[#aaa]">{t.text}</p><p class="mt-4 text-sm font-semibold text-fuchsia-300">Use free →</p></a>)}</div></section>
  {groups.map(group => <section id={group.id} class="max-w-6xl mx-auto px-6 py-10 scroll-mt-20"><h2 class="text-2xl font-bold mb-6">{group.title} <span class="text-sm font-normal text-[#888]">· free preview, full AI report with Pro</span></h2><div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">{group.tools.map(tool => <article class="flex flex-col rounded-2xl border border-white/10 bg-[#101010] p-6"><p class="text-xs text-fuchsia-300">{tool.audience === 'women' ? 'Your preferences come first' : tool.requiresComparison ? 'Two-photo comparison' : 'Start without an account'}</p><h3 class="mt-3 text-2xl font-bold"><a href={`/tools/${tool.slug}`}>{tool.name}</a></h3><p class="mt-3 mb-7 text-[#aaa] leading-relaxed flex-1">{tool.description}</p><a href={toolHref(tool.slug, `/tools/${tool.slug}`, APP_URL)} data-tool={tool.slug} data-placement="tool-directory" class="rounded-xl btn-gradient p-3 text-center text-sm font-bold">Try with my photo →</a><a href={`/tools/${tool.slug}`} class="mt-3 text-sm text-center text-[#888]">See what's included</a></article>)}</div></section>)}
  <p class="max-w-6xl mx-auto px-6 pb-16 text-sm text-[#777]">AI styling suggestions are subjective. Tool reports do not provide medical advice or precise physical measurements.</p>
</BaseLayout>
