---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

const APP_URL = import.meta.env.PUBLIC_APP_URL;
const SITE_URL = import.meta.env.PUBLIC_SITE_URL ?? 'https://aura-looksmaxxing.com';

export async function getStaticPaths() {
  const terms = await getCollection('glossary', ({ data }) => !data.draft);
  return terms.map(term => ({
    params: { slug: term.data.slug },
    props: { term },
  }));
}

const { term } = Astro.props;
const { Content } = await render(term);

const allTerms = await getCollection('glossary', ({ data }) => !data.draft);
const relatedTerms = term.data.related_terms?.length
  ? allTerms.filter(t => term.data.related_terms.includes(t.data.slug)).slice(0, 5)
  : [];

const definitionSchema = {
  '@context': 'https://schema.org',
  '@type': 'DefinedTerm',
  name: term.data.term,
  description: term.data.short_definition,
  inDefinedTermSet: { '@type': 'DefinedTermSet', name: 'Looksmaxxing Glossary', url: `${SITE_URL}/glossary` },
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE_URL },
    { '@type': 'ListItem', position: 2, name: 'Glossary', item: `${SITE_URL}/glossary` },
    { '@type': 'ListItem', position: 3, name: term.data.term, item: `${SITE_URL}/glossary/${term.data.slug}` },
  ],
};
---

<BaseLayout title={`${term.data.term}${term.data.abbreviation ? ` (${term.data.abbreviation})` : ''} - Looksmaxxing Glossary | Aura`} description={term.data.description}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(definitionSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  </Fragment>

  <article class="max-w-2xl mx-auto px-4 pt-16 pb-12">
    <nav class="text-xs text-[#666] mb-8 flex items-center gap-2">
      <a href="/" class="hover:text-white transition-colors">Home</a>
      <span>/</span>
      <a href="/glossary" class="hover:text-white transition-colors">Glossary</a>
    </nav>

    <header class="mb-10">
      <h1 class="text-4xl md:text-5xl font-black text-white leading-tight mb-2">
        {term.data.term}
        {term.data.abbreviation && <span class="text-[#666] text-2xl ml-3 font-normal">({term.data.abbreviation})</span>}
      </h1>
      <p class="text-lg text-fuchsia-400 leading-relaxed">{term.data.short_definition}</p>
    </header>

    <div class="prose prose-invert prose-lg max-w-none">
      <Content />
    </div>

    {term.data.examples?.length > 0 && (
      <section class="mt-10 bg-[#111] rounded-2xl p-6 border border-white/5">
        <h2 class="text-white font-bold mb-3">Examples in context</h2>
        <ul class="space-y-2">
          {term.data.examples.map(ex => (
            <li class="text-[#aaa] italic before:content-['"'] after:content-['"']">{ex}</li>
          ))}
        </ul>
      </section>
    )}
  </article>

  <section class="bg-[#080808] border-y border-white/5 py-12">
    <div class="max-w-2xl mx-auto px-4 text-center">
      <h2 class="text-2xl md:text-3xl font-black text-white mb-3">Want to know your real PSL score?</h2>
      <p class="text-[#888] text-base mb-6">Aura analyzes your face with AI and gives you an honest looksmaxxing rating.</p>
      <a href={`${APP_URL}/register`} class="inline-block btn-gradient text-white font-bold px-7 py-3 rounded-full hover:opacity-90 transition-opacity">
        Get rated free →
      </a>
    </div>
  </section>

  {relatedTerms.length > 0 && (
    <section class="max-w-3xl mx-auto px-4 py-12">
      <h2 class="text-lg font-bold text-white mb-4">Related terms</h2>
      <div class="grid sm:grid-cols-2 gap-3">
        {relatedTerms.map(t => (
          <a href={`/glossary/${t.data.slug}`} class="group bg-[#111] hover:bg-[#161616] rounded-xl p-4 border border-white/5 hover:border-white/10 transition-colors">
            <h3 class="text-white font-bold text-sm group-hover:text-fuchsia-400 transition-colors">{t.data.term}</h3>
            <p class="text-[#888] text-xs mt-1 line-clamp-1">{t.data.short_definition}</p>
          </a>
        ))}
      </div>
    </section>
  )}
</BaseLayout>
