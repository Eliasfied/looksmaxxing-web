---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const terms = (await getCollection('glossary', ({ data }) => !data.draft))
  .sort((a, b) => a.data.term.localeCompare(b.data.term));

// Group by first letter for A-Z navigation
const byLetter = new Map<string, typeof terms>();
for (const t of terms) {
  const letter = t.data.term[0].toUpperCase();
  if (!byLetter.has(letter)) byLetter.set(letter, []);
  byLetter.get(letter)!.push(t);
}
const letters = [...byLetter.keys()].sort();
---

<BaseLayout
  title="Looksmaxxing Glossary | Slang and Terms Explained | Aura"
  description="Every looksmaxxing term, abbreviation, and slang word explained. PSL, HTN, LTN, mogging, mewing, canthal tilt, and 50+ more."
>
  <section class="relative overflow-hidden">
    <div class="pointer-events-none absolute inset-0">
      <div class="absolute -top-40 left-1/2 h-[600px] w-[600px] -translate-x-1/2 rounded-full bg-purple-600/10 blur-[140px]"></div>
    </div>
    <div class="relative max-w-5xl mx-auto px-4 pt-20 pb-12">
      <h1 class="text-4xl md:text-6xl font-black text-white mb-4 leading-tight">
        Looksmaxxing <span class="bg-gradient-to-r from-fuchsia-400 to-violet-400 bg-clip-text text-transparent">Glossary</span>
      </h1>
      <p class="text-lg text-[#aaa] max-w-2xl mb-8">
        Plain-English definitions for every term, abbreviation, and slang word in the looksmaxxing community.
      </p>

      {letters.length > 0 && (
        <nav class="flex flex-wrap gap-2">
          {letters.map(l => (
            <a href={`#letter-${l}`} class="bg-[#111] hover:bg-[#1a1a1a] border border-white/5 rounded-lg px-3 py-1.5 text-sm text-white font-bold transition-colors">{l}</a>
          ))}
        </nav>
      )}
    </div>
  </section>

  <section class="max-w-5xl mx-auto px-4 pb-24">
    {letters.map(letter => (
      <div class="mb-12" id={`letter-${letter}`}>
        <h2 class="text-3xl font-black text-fuchsia-400 mb-4 sticky top-0 bg-black/80 backdrop-blur py-2 z-10">{letter}</h2>
        <div class="grid sm:grid-cols-2 gap-3">
          {byLetter.get(letter)!.map(t => (
            <a
              href={`/glossary/${t.data.slug}`}
              class="group bg-[#111] hover:bg-[#161616] rounded-xl p-5 border border-white/5 hover:border-white/10 transition-colors"
            >
              <h3 class="text-white font-bold mb-1 group-hover:text-fuchsia-400 transition-colors">
                {t.data.term}
                {t.data.abbreviation && <span class="text-[#666] text-sm ml-2 font-normal">({t.data.abbreviation})</span>}
              </h3>
              <p class="text-[#888] text-sm line-clamp-2">{t.data.short_definition}</p>
            </a>
          ))}
        </div>
      </div>
    ))}

    {terms.length === 0 && (
      <p class="text-[#666] text-center py-16">No glossary terms yet. Check back soon.</p>
    )}
  </section>
</BaseLayout>
