---
import BaseLayout from '../layouts/BaseLayout.astro';

const BRAND_NAME = import.meta.env.PUBLIC_BRAND_NAME ?? 'Aura: Looksmaxxing';
const SITE_URL = import.meta.env.PUBLIC_SITE_URL ?? 'https://looksmaxxing.ai';
---

<BaseLayout
  title={`About | ${BRAND_NAME}`}
  description={`${BRAND_NAME} is an AI-powered looksmaxxing platform built to help you unlock your best look.`}
>
  <section class="max-w-2xl mx-auto px-4 py-24">

    <h1 class="text-4xl md:text-5xl font-black text-white mb-10">About {BRAND_NAME}</h1>

    <div class="space-y-6 text-[#888] leading-relaxed">

      <p>
        {BRAND_NAME} is an AI-powered platform built for anyone serious about improving their appearance.
        We combine face analysis, hairstyle try-on, personalized glow-up routines, and an AI coaching assistant
        into one simple tool.
      </p>

      <p>
        The idea is straightforward: looksmaxxing advice should be data-driven, personalized, and accessible.
        No guesswork — just an honest PSL score, a potential score, and a concrete plan to get there.
      </p>

      <p>
        Whether you're optimizing your haircut, building a skincare routine, or just curious where you
        stand — {BRAND_NAME} gives you the tools to level up.
      </p>

      <p>
        Questions or feedback? Reach out anytime.
      </p>

    </div>

    <div class="mt-12">
      <a
        href={`mailto:support@${new URL(SITE_URL).hostname}`}
        class="flex items-center gap-2 bg-[#111] border border-[#222] rounded-xl px-5 py-3 text-white text-sm hover:border-[#444] transition-colors w-fit"
      >
        Contact Us
      </a>
    </div>

  </section>
</BaseLayout>
