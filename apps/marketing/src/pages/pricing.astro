---
import BaseLayout from '../layouts/BaseLayout.astro';
import PricingSection from '../components/PricingSection.astro';

const BRAND_NAME = import.meta.env.PUBLIC_BRAND_NAME ?? 'Aura: Looksmaxxing';
const SITE_URL = import.meta.env.PUBLIC_SITE_URL ?? 'https://www.aura-looksmaxxing.com';

const pricingSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": BRAND_NAME,
  "applicationCategory": "LifestyleApplication",
  "operatingSystem": "Web",
  "url": `${SITE_URL}/pricing`,
  "offers": [
    {
      "@type": "Offer",
      "name": "Monthly",
      "price": "9.99",
      "priceCurrency": "USD",
      "url": `${SITE_URL}/pricing`,
      "availability": "https://schema.org/InStock",
      "priceSpecification": {
        "@type": "UnitPriceSpecification",
        "price": "9.99",
        "priceCurrency": "USD",
        "unitCode": "MON",
      },
    },
    {
      "@type": "Offer",
      "name": "Yearly",
      "price": "49.99",
      "priceCurrency": "USD",
      "url": `${SITE_URL}/pricing`,
      "availability": "https://schema.org/InStock",
      "priceSpecification": {
        "@type": "UnitPriceSpecification",
        "price": "49.99",
        "priceCurrency": "USD",
        "unitCode": "ANN",
      },
    },
  ],
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": `${SITE_URL}/` },
    { "@type": "ListItem", "position": 2, "name": "Pricing", "item": `${SITE_URL}/pricing` },
  ],
};
---

<BaseLayout
  title={`Pricing - ${BRAND_NAME}`}
  description="One plan, everything included. $9.99/mo or $49.99/yr. AI Face Analysis, Glow Up Plan, AI Coach, Hairstyle Try-On and more."
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(pricingSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  </Fragment>

  <header class="max-w-3xl mx-auto px-6 pt-16 pb-2 text-center">
    <h1 class="text-5xl md:text-6xl font-black text-white leading-tight">
      {BRAND_NAME} <span class="bg-gradient-to-r from-fuchsia-400 to-violet-400 bg-clip-text text-transparent">Pricing</span>
    </h1>
    <p class="text-[#888] mt-5 text-base max-w-md mx-auto">
      One plan. Everything included. $9.99/month or $49.99/year — cancel anytime.
    </p>
  </header>

  <PricingSection />

  <section class="max-w-3xl mx-auto px-6 py-16 border-t border-white/5">
    <h2 class="text-2xl md:text-3xl font-black text-white mb-3">What's included</h2>
    <p class="text-[#888] mb-8 leading-relaxed">
      There is no feature gating between the two plans. Monthly and yearly differ only in how often you are
      billed. Everything below is part of both.
    </p>

    <div class="grid sm:grid-cols-2 gap-4">
      <div class="bg-[#111] border border-white/5 rounded-2xl p-6">
        <h3 class="text-white font-bold mb-2">AI Face Analysis</h3>
        <p class="text-[#888] text-sm leading-relaxed">
          Your PSL score plus a breakdown across bone structure, eye area, skin, hair and symmetry. The model
          reads over 10 facial metrics, including gonial angle, midface ratio, cheekbone prominence, canthal
          tilt, eye distance, skin clarity, hairline depth and asymmetry index.
        </p>
      </div>

      <div class="bg-[#111] border border-white/5 rounded-2xl p-6">
        <h3 class="text-white font-bold mb-2">Personalized Glow Up Plan</h3>
        <p class="text-[#888] text-sm leading-relaxed">
          Targeted steps derived from your own measurements, aimed at closing the gap between your current
          score and your potential score. Covers skincare, jawline training, hairstyle, diet, grooming and
          posture.
        </p>
      </div>

      <div class="bg-[#111] border border-white/5 rounded-2xl p-6">
        <h3 class="text-white font-bold mb-2">AI Looksmaxxing Coach</h3>
        <p class="text-[#888] text-sm leading-relaxed">
          A chat assistant with access to your full analysis, available around the clock. Because it reads
          your actual facial data, the answers are specific to your face rather than generic advice.
        </p>
      </div>

      <div class="bg-[#111] border border-white/5 rounded-2xl p-6">
        <h3 class="text-white font-bold mb-2">50 Try-Ons per month</h3>
        <p class="text-[#888] text-sm leading-relaxed">
          Hairstyles, beard styles and glasses rendered onto your own photo, so you can see a cut before you
          commit to it. Styles are matched to your detected face shape.
        </p>
      </div>
    </div>
  </section>

  <section class="max-w-3xl mx-auto px-6 py-16 border-t border-white/5">
    <h2 class="text-2xl md:text-3xl font-black text-white mb-8">How billing works</h2>

    <dl class="space-y-6">
      <div>
        <dt class="text-white font-bold mb-1">Monthly or yearly</dt>
        <dd class="text-[#888] text-sm leading-relaxed">
          Monthly is $9.99 and renews every month. Yearly is $49.99 charged once, which works out to roughly
          $4.17 per month and saves about 58% against the monthly rate.
        </dd>
      </div>

      <div>
        <dt class="text-white font-bold mb-1">Cancelling</dt>
        <dd class="text-[#888] text-sm leading-relaxed">
          You can cancel at any time. Your access continues until the end of the billing period you have
          already paid for, and you are not charged again after that. There is no cancellation step where we
          ask you why.
        </dd>
      </div>

      <div>
        <dt class="text-white font-bold mb-1">Your photos</dt>
        <dd class="text-[#888] text-sm leading-relaxed">
          Photos are processed securely and are never shared with third parties. They are kept only as long as
          delivering your analysis requires, and you can request deletion at any time by contacting support.
        </dd>
      </div>

      <div>
        <dt class="text-white font-bold mb-1">What this is not</dt>
        <dd class="text-[#888] text-sm leading-relaxed">
          The analysis is built on established looksmaxxing frameworks and gives you a consistent baseline to
          work from. It is not a medical or professional aesthetic assessment, and it should not be treated as
          one.
        </dd>
      </div>
    </dl>

    <p class="text-[#666] text-sm mt-10">
      More questions are answered on the <a href="/faq" class="text-fuchsia-400 hover:text-fuchsia-300">FAQ page</a>.
      You can also try the <a href="/tools" class="text-fuchsia-400 hover:text-fuchsia-300">free tools</a> or read the
      <a href="/blog" class="text-fuchsia-400 hover:text-fuchsia-300">looksmaxxing guides</a> before subscribing.
    </p>
  </section>
</BaseLayout>
