---
import BaseLayout from '../layouts/BaseLayout.astro';
import PricingSection from '../components/PricingSection.astro';
import GlowPlanTeaser from '../components/GlowPlanTeaser.astro';
import { appConfig } from '../lib/config';
const glow = appConfig.pricing.glowPlan;
const price = glow.price.toFixed(2);
const looks = Math.floor(glow.credits / appConfig.credits.tryOn);
const schema = { '@context': 'https://schema.org', '@type': 'SoftwareApplication', name: 'Aura: Looksmaxxing', applicationCategory: 'LifestyleApplication', operatingSystem: 'Web', offers: [{ '@type': 'Offer', name: 'Free on-device preview', price: '0', priceCurrency: 'USD' }, { '@type': 'Offer', name: glow.name, price, priceCurrency: 'USD' }, { '@type': 'Offer', name: 'Aura Pro monthly', price: '9.99', priceCurrency: 'USD' }, { '@type': 'Offer', name: 'Aura Pro yearly', price: '49.99', priceCurrency: 'USD' }] };
---
<BaseLayout title={`Aura Pricing: 30-Day Glow-Up Plan for $${price} Once | Aura`} description={`Free face previews run in your browser. The 30-Day Glow-Up Plan costs $${price} once: a big face scan, a personal daily plan, try-ons, an AI coach and a day-30 re-scan. Aura Pro is also available as a subscription.`}>
  <Fragment slot="head"><script type="application/ld+json" set:html={JSON.stringify(schema)} /></Fragment>
  <header class="max-w-3xl mx-auto px-6 pt-16 text-center"><h1 class="text-5xl font-black">Aura pricing</h1><p class="mt-5 text-[#aaa] text-lg">Try the free previews first. When you want a plan, pay once.</p></header>
  <PricingSection source="/pricing" />
  <div class="max-w-6xl mx-auto px-6 pb-12"><GlowPlanTeaser source="/pricing" heading="What the 30-day plan looks like" /></div>
  <section class="max-w-3xl mx-auto px-6 pb-16"><h2 class="text-2xl font-bold">What is free?</h2><p class="mt-4 text-[#aaa] leading-relaxed">The previews on our tool pages measure your face shape, symmetry, canthal tilt and eye shape directly in your browser. The photo is not uploaded and you need no account. They are estimates from one photo, and we say so next to every number.</p>
    <h2 class="mt-10 text-2xl font-bold">What does the 30-Day Glow-Up Plan include?</h2><ul class="list-disc pl-5 mt-4 space-y-2 text-[#aaa]"><li>A big start scan: PSL score, nine sub-scores and a short questionnaire about your skin, hair, body, diet, sleep, time and budget.</li><li>Your personal plan: 30 days of tasks for the areas you choose (skin, hair, face and jawline, nutrition, training, style), a morning and evening routine, and the product types to buy.</li><li>{looks} try-ons, including Future Me, a realistic day-30 goal picture.</li><li>The AI coach, all AI reports and progress tracking for {glow.accessDays} days, so you can start a few days late and still do the day-30 re-scan.</li><li>A PDF of your plan. The plan and the PDF stay in your account after the {glow.accessDays} days.</li></ul>
    <h2 class="mt-10 text-2xl font-bold">Billing</h2><p class="mt-4 text-[#aaa] leading-relaxed">The 30-day plan is a one-time payment of ${price}. It does not renew and there is nothing to cancel. If you prefer ongoing access, Aura Pro is a subscription for $49.99 a year or $9.99 a month; cancel in your account settings before the renewal date to stop the next charge.</p>
    <h2 class="mt-10 text-2xl font-bold">Your photos and results</h2><p class="mt-4 text-[#aaa] leading-relaxed">Free previews never leave your device. For AI scans, reports and try-ons, the photo is sent to our AI processing service. We never sell or share photos. See our <a href="/privacy" class="text-fuchsia-300">privacy policy</a> for details.</p>
  </section>
</BaseLayout>
