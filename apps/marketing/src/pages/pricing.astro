---
import BaseLayout from '../layouts/BaseLayout.astro';
import PricingSection from '../components/PricingSection.astro';

const BRAND_NAME = import.meta.env.PUBLIC_BRAND_NAME ?? 'Aura: Looksmaxxing';
const SITE_URL = import.meta.env.PUBLIC_SITE_URL ?? 'https://looksmaxxing.ai';

const pricingSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": BRAND_NAME,
  "applicationCategory": "HealthApplication",
  "operatingSystem": "Web",
  "offers": [
    {
      "@type": "Offer",
      "name": "Monthly",
      "price": "9.99",
      "priceCurrency": "USD",
      "billingDuration": "P1M",
    },
    {
      "@type": "Offer",
      "name": "Yearly",
      "price": "49.99",
      "priceCurrency": "USD",
      "billingDuration": "P1Y",
    },
  ],
};
---

<BaseLayout
  title={`Pricing - ${BRAND_NAME}`}
  description="One plan, everything included. $9.99/mo or $49.99/yr. AI Face Analysis, Glow Up Plan, AI Coach, Hairstyle Try-On and more."
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(pricingSchema)} />
  </Fragment>

  <PricingSection />
</BaseLayout>
