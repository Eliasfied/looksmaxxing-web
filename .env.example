# Copy this file to .env.local and fill in your values
# Next.js runtime variables belong in apps/web/.env.local for local development.

# Tool preview reports (server only); generate locally: node scripts/setup-tool-secret.mjs
TOOL_REPORT_SECRET=
# Vercel supplies this bearer secret to the daily expired-report cleanup.
CRON_SECRET=
DAILY_TOOL_PREVIEW_LIMIT=100
# Set an exact https origin for a hosted preview environment when needed.
APP_ORIGIN=https://app.aura-looksmaxxing.com
# Optional override for the existing server-side photo-analysis service.
FACE_ANALYSIS_URL=https://openai-secure-proxy.vercel.app/api/chat
# GPT-6 Luna defaults for photo reports, legacy face scans and the AI coach.
# Explicit rollback per workload: gpt-4.1-mini (no automatic second paid call).
FACE_ANALYSIS_MODEL=gpt-6-luna
AI_CHAT_MODEL=gpt-6-luna
# Optional separate Chat Completions proxy; otherwise uses FACE_ANALYSIS_URL.
# AI_CHAT_URL=
# Keep false in production; only opt in explicitly when testing RC sandbox payments.
ALLOW_SANDBOX_PAYMENTS=false

# Content generation (scripts/.env.local, root .env.local or CI environment)
CONTENT_MODEL=claude-opus-5-5
CONTENT_EFFORT=medium
CONTENT_REVIEW_MODEL=claude-sonnet-5-5

# Firebase (Client SDK – public)
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSy...
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789:web:abc123

# Firebase Admin SDK (Server-side only – never expose publicly)
# Paste the entire service account JSON as a single-line string
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# RevenueCat (Web Billing)
NEXT_PUBLIC_REVENUECAT_API_KEY=rcb_your_key_here
REVENUECAT_WEBHOOK_SECRET=your-webhook-secret

# AI Generation (fal.ai)
FAL_API_KEY=your-fal-api-key

# pSEO + Script Generation (Anthropic Claude API)
ANTHROPIC_API_KEY=your-anthropic-api-key

# Analytics (PostHog)
NEXT_PUBLIC_POSTHOG_KEY=phc_your_key
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# SEO (IndexNow for Bing)
INDEXNOW_KEY=your-indexnow-key
